# Reverse proxy for production (TD §3.2, docs/deployment.md).
#
# Eksoda is reachable only on the home network and through the VPN, so a public
# certificate authority cannot validate the name. Caddy signs the certificate with its
# own local CA instead (`tls internal`). Clients trust that CA once: `make prod-ca`
# exports its root certificate.
#
# Caddy listens on the same port numbers as the host publishes (HTTP_PORT, HTTPS_PORT).
#
# No access log on purpose: Django logs every request (status, duration, path) with the
# request id, and URLs never carry receipt links.

{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	# The CA lives in the caddy_data volume; there is no system trust store to update.
	skip_install_trust
}

{$DOMAIN} {
	tls internal

	encode zstd gzip

	# API bodies are small JSON (Django rejects anything over 16 KB); admin forms too.
	request_body {
		max_size 1MB
	}

	header -Server

	# Django trusts X-Forwarded-Proto (SECURE_PROXY_SSL_HEADER), which Caddy sets. No
	# active health check: it would send Host "api:8000", which ALLOWED_HOSTS rejects;
	# compose already waits for the api healthcheck and restarts failed containers.
	reverse_proxy api:8000
}

# Caddy's automatic redirect leaves out a non-standard HTTPS port; this one keeps it.
http://{$DOMAIN} {
	redir https://{host}:{$HTTPS_PORT:443}{uri} permanent
}
