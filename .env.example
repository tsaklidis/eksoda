# Copy to .env (`make env` does this) and adjust. Never commit .env.
# Development defaults work out of the box with `make up`.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in production: at least 50 random characters
# (python -c "import secrets; print(secrets.token_urlsafe(64))").
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_PATH=admin/

# --- Database (used by the db container and by Django) ---------------------
POSTGRES_DB=eksoda
POSTGRES_USER=eksoda
POSTGRES_PASSWORD=eksoda
DATABASE_URL=postgres://eksoda:eksoda@db:5432/eksoda

# Host ports published by the dev stack (127.0.0.1 only).
DB_HOST_PORT=55432
API_HOST_PORT=8000

# --- Redis (Celery broker uses db 0, cache and throttles use db 1) ---------
REDIS_URL=redis://redis:6379

# --- Authentication ---------------------------------------------------------
# Defaults to DJANGO_SECRET_KEY when empty.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# false = registration requires a household invitation code (D2).
REGISTRATION_OPEN=false

# --- Rate limits ---------------------------------------------------------------
THROTTLE_LOGIN=5/min
THROTTLE_LOGIN_IP=30/min
THROTTLE_REGISTER=10/hour
THROTTLE_JOIN=20/hour
# Receipt imports per user.
THROTTLE_IMPORT_MINUTE=30/min
THROTTLE_IMPORT_DAY=500/day
# Receipt page fetches per worker (Celery rate limit).
IMPORT_TASK_RATE_LIMIT=30/m

# --- Logging and error tracking ------------------------------------------------
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
# Optional error tracking (production only). Events are scrubbed of URLs and bodies.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# --- Production only (compose.prod.yaml, docs/deployment.md) ------------------------
# Host name that clients on the LAN and the VPN use (a local DNS record, for example
# eksoda.lan in Pi-hole). Caddy signs its certificate with a local CA: `make prod-ca`.
DOMAIN=
# Host ports the proxy publishes. Change them when another service (Pi-hole, for
# example) already uses 80/443. Never forward them on the router.
HTTP_PORT=80
HTTPS_PORT=443
# Process counts: 2 gunicorn workers and 1 Celery process suit a Raspberry Pi.
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=1
# Daily pg_dump: directory on the host, hour (UTC) and retention.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=1
BACKUP_RETENTION_DAYS=30
